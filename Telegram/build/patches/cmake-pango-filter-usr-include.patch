diff --git a/external/pango/CMakeLists.txt b/external/pango/CMakeLists.txt
index 25c56c1..a2176df 100644
--- a/external/pango/CMakeLists.txt
+++ b/external/pango/CMakeLists.txt
@@ -16,3 +16,19 @@ INTERFACE
     PkgConfig::DESKTOP_APP_PANGOCAIRO
     $<TARGET_NAME_IF_EXISTS:PkgConfig::DESKTOP_APP_PANGOFT2>
 )
+
+# pkg-config IMPORTED_TARGET may inject /usr/include as a SYSTEM include.
+# GCC then fails on <cmath>'s `#include_next <math.h>` when compiling
+# text_shaper_pango.cpp (seen with Debian 13 + GCC 14 + packaged Qt).
+# /usr/include is already in the compiler's default search path.
+foreach(_tgt PkgConfig::DESKTOP_APP_PANGOCAIRO PkgConfig::DESKTOP_APP_PANGOFT2)
+    if (TARGET ${_tgt})
+        foreach(_prop INTERFACE_INCLUDE_DIRECTORIES INTERFACE_SYSTEM_INCLUDE_DIRECTORIES)
+            get_target_property(_incs ${_tgt} ${_prop})
+            if (_incs)
+                list(REMOVE_ITEM _incs "/usr/include")
+                set_property(TARGET ${_tgt} PROPERTY ${_prop} "${_incs}")
+            endif()
+        endforeach()
+    endif()
+endforeach()
